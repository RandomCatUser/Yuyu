# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Discord ---
# Application ID, from the Developer Portal "General Information" page.
DISCORD_APPLICATION_ID=
# Same value as the application id.
DISCORD_CLIENT_ID=
# "General Information" -> Public Key. 64 hex characters.
DISCORD_PUBLIC_KEY=

# OAuth2 client secret. Optional - only used to build the install link.
# This is NOT the bot token and cannot be used to log in.
DISCORD_CLIENT_SECRET=

# Bot token: Developer Portal -> Bot -> "Reset Token".
# Must look like <id>.<something>.<something> - two dots.
DISCORD_TOKEN=

# --- Model providers (add a key for every provider you want to use) ---
# The bot tries providers in config.json order and falls through on quota,
# rate-limit, authentication, network, and server errors.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=

# --- Local dashboard (optional) ---
# Only used when dashboard.enabled is true in config.json.
# There is no password: the panel binds to 127.0.0.1 only and refuses to start
# on any other host, because it can rewrite her persona, skills and memory.
# DASHBOARD_HOST=127.0.0.1